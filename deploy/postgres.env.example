# Template only. Fill through the deployment host's secret configuration.
# Use the exact direct/session endpoint supplied by Supabase Connect.
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/ats-certs/root.crt
DATABASE_SCHEMA=ats
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
ENVIRONMENT=production
ATS_REQUIRE_ORIGIN_AUTH=true
ATS_ORIGIN_SERVICE_KEY=REPLACE_WITH_SEPARATE_APPROVED_SERVICE_SECRET
JWT_SECRET_KEY=REPLACE_WITH_PERSISTENT_RANDOM_SECRET
AI_ENCRYPTION_KEY=
BACKEND_CORS_ORIGINS=["https://REPLACE_PRIVATE_SITE_ORIGIN"]
TASK_SCHEDULER_ENABLED=true
LOG_FILE=/var/lib/ats/logs/controller.log
ATS_MAX_EXECUTION_LOG_BYTES=268435456
