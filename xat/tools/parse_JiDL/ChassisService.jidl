        /**
         * @fn GetGearShiftParkStatus
         * @brief 获取驻车档位状态
         * @return GearShiftPark 当前驻车档位状态
         */
        @method
        GearShiftPark GetGearShiftParkStatus();

        /**
         * @fn GetSportModeAvailableStatus
         * @brief 获取运动模式激活状态
         * @return SportModeAvlStatus 当前运动模式激活状态
         */
        @method
        SportModeAvlStatus GetSportModeAvailableStatus();

        /**
         * @fn ChassisFault
         * @brief 通知当前chassis模块故障列表（底层数据无效）
         * @param[out] faults 当前chassis模块存在的故障列表（底层数据无效）
         */
        @event
        ChassisFault(sequence<ChassisFault> faults);

        /**
         * @fn DisplaySpeedChanged
         * @brief 通知仪表盘车速
         * @param[out] speed, 当前仪表盘车速
         */
        @event
        DisplaySpeedChanged(SpeedWithUnit speed);

        /**
         * @fn SpeedChanged
         * @brief 通知车速变化
         * @param[out] SpeedFloat, 当前车速 //
         */
        @event
        SpeedChanged(SpeedFloat speed);

        /**
         * @fn TorqueMode
         * @brief 通知当前扭矩模式
         * @param[out] mode, 当前扭矩模式
         */
        @event
        TorqueMode(TorqueMode mode);

        /**
         * @fn Gear
         * @brief 通知当前挡位
         * @param[out] gear, 当前挡位
         */
        @event
        Gear(Gear gear);

        /**
         * @fn GearFault
         * @brief 通知当前挡位故障
         * @param[out] fault, 当前挡位故障类型
         */
        @event
        GearFault(sequence<GearLvlFaultStatus> faults);

        /**
         * @fn WheelSpeed
         * @brief 通知当前轮速
         * @param[out] wheelsSpeed, 当前轮速数组
         */
        @event
        WheelSpeed(sequence<WheelSpeed> wheelsSpeed);

        /**
         * @fn WheelImpluseCounter
         * @brief 通知当前车轮旋转脉冲数
         * @param[out] wheelsImpluseCounter, 当前车轮旋转脉冲数 数组
         */
        @event
        WheelImpluseCounter(sequence<WheelImpluseCounter> wheelsImpluseCounter);

        /**
         * @fn VehicleMotionState
         * @brief 通知车辆运动状态
         * @param[out] state, 当前车辆运动状态
         */
        @event
        VehicleMotionState(MotionState  state);

        /**
         * @fn SteerErrorReqStatus
         * @brief 通知EPS转向错误响应状态
         * @param[out] state, 当前EPS转向错误响应状态
         */
        @event
        SteerErrorReqStatus(SteerErrorReqStatus  state);

        /**
         * @fn ESCWorkStatus
         * @brief 通知ESC工作状态
         * @param[out] state, 当前ESC工作状态
         */
        @event
        ESCWorkStatus(ESCWorkStatus  state);

        /**
         * @fn EPBOperationStatus
         * @brief 通知EPB操作状态
         * @param[out] state, 当前EPB操作状态 0-15 ： type0 - type15
         */
        @event
        EPBOperationStatus(uint8  state);

        /**
         * @fn HDCFunctionAvailableChanged
         * @brief 通知陡坡缓降功能可用状态变化
         * @param[out] on 功能可用状态 true - 可用（HMI可进行使能）， false - 不可用（开关需置灰）
         */
        @event
        HDCFunctionAvailableChanged(bool on);

        /**
         * @fn HDCChanged
         * @brief 通知陡坡缓降功能使能状态变化
         * @param[out] on 当前陡坡缓降功能使能状态 true - 已使能， false - 未使能
         */
        @event
        HDCChanged(bool on);

        /**
         * @fn ESCChanged
         * @brief 通知ESC功能使能状态状态变化
         * @param[out] on 当前ESC功能使能状态状态 true - 已使能， false - 未使能
         */
        @event
        ESCChanged(bool on);

        /**
         * @fn AutoHoldChanged
         * @brief 通知自动驻车功能使能状态状态变化
         * @param[out] on 当前自动驻车功能使能状态状态 true - 已使能， false - 未使能
         */
        @event
        AutoHoldChanged(bool on);

        /**
         * @fn SuspensionLevel
         * @brief 通知悬架减震等级变化
         * @param[out] level 当前悬架减震等级
         */
        @event
        SuspensionLevel(uint8 level);

        /**
         * @fn TraveledDistance
         * @brief 通知行驶里程
         * @param[out] value, 当前行驶里程
         */
        @event
        TraveledDistance(uint32 value);

        /**
         * @fn CoastEnergyRegenerateMode
         * @brief 通知滑行能量模式状态变化
         * @param[out] on 功能开关请求 true - 开启， false - 关闭
         */
        @event
        CoastEnergyRegenerateMode(bool on);

        /**
         * @fn CreepMode
         * @brief 通知蠕行模式状态变化
         * @param[out] on 功能开关状态 true - 开启， false - 关闭
         */
        @event
        CreepMode(bool on);

        /**
         * @fn GearShiftParkStatus
         * @brief 通知驻车档位状态变化
         * @param[out] state.parkReq 功能开关状态 true - 开启， false - 关闭
         * @param[out] state.validSts 状态有效性 true - 有效， false - 无效
         */
        @event
        GearShiftParkStatus(GearShiftPark state);

        /**
         * @fn SportModeAvailableStatus
         * @brief 通知运动模式激活状态变化
         * @param[out] state 运动模式激活状态
         */
        @event
        SportModeAvailableStatus(SportModeAvlStatus state);
    /**************************************** v0.5.5 end ************************/
};
};
