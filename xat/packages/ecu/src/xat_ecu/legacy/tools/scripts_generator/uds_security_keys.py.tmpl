import logging

from .uds_const import EcuCanId


def getSecretMSB(candidateSecurityAccessLevel, ecuCanId: int):
    msb = {
% for ecuId in data['ecuId']:
        EcuCanId.${ecuId}: {  \
% for security_level in data['ecuId'][ecuId]:
<% msb = (data['ecuId'][ecuId][security_level] & 0xFF00) >> 8 %>
            ${security_level}: ${msb},
% endfor
        },
% endfor
    }
    try:
        return msb[ecuCanId][candidateSecurityAccessLevel]
    except KeyError:
        logging.error("Unable to determine secret for SecurityAccess for 0x{:03X}, level {}".format(ecuCanId, candidateSecurityAccessLevel))
        return 0


