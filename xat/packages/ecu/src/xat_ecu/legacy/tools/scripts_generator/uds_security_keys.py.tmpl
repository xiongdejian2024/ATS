    lsb = {
% for ecuId in data['ecuId']:
        EcuCanId.${ecuId}: {  \
% for security_level in data['ecuId'][ecuId]:
<% lsb = (data['ecuId'][ecuId][security_level] & 0xFF) %>
            ${security_level}: ${lsb},
% endfor
